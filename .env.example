# Sthalo environment decisions (local defaults only).
# Copy the app-specific examples:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
#
# Hosted URLs are intentionally blank. Record the actual generated URLs in the
# provider dashboard and deployment notes only after the services exist and the
# no-card signup/deployment flow has been verified.

STHALO_PRODUCT_NAME=Sthalo
STHALO_REPOSITORY_NAME=sthalo
STHALO_SUPABASE_PROJECT=sthalo-demo
STHALO_SUPABASE_REGION_PREFERENCE=ap-south-1
STHALO_SUPABASE_REGION_FALLBACK=ap-southeast-1
STHALO_SUPABASE_REGION_ACTUAL=
STHALO_HOSTED_AUTH_MODE=disabled-confirmation-demo-accounts

# Local backend
# Get local keys from `npx supabase@2.122.0 status -o env`. Use ANON_KEY and
# SERVICE_ROLE_KEY (legacy JWT keys) or PUBLISHABLE_KEY and SECRET_KEY.
ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173
SWEEPER_ENABLED=true
ALLOW_SWEEPER_DISABLED=false
SWEEPER_INTERVAL_SECONDS=45
MAX_UPLOAD_BYTES=5242880
GEOCODE_PROVIDER=none

# Local frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Hosted values: fill only after actual creation and no-card verification.
HOSTED_FRONTEND_ORIGIN=
HOSTED_API_BASE_URL=
