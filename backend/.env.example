# Sthalo backend environment (local defaults)
# Copy to backend/.env. Get local keys from `npx supabase@2.122.0 status -o env`;
# use ANON_KEY and SERVICE_ROLE_KEY (legacy JWT keys) or PUBLISHABLE_KEY and
# SECRET_KEY. Hosted URLs are intentionally absent; set them in the host
# dashboard after the provider has actually created the service.

ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5173
SWEEPER_ENABLED=true
ALLOW_SWEEPER_DISABLED=false
SWEEPER_INTERVAL_SECONDS=45
MAX_UPLOAD_BYTES=5242880
GEOCODE_PROVIDER=none
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=300
RATE_LIMIT_READ_REQUESTS=600
RATE_LIMIT_BOOKING_REQUESTS=120
RATE_LIMIT_TRUST_PROXY=false
