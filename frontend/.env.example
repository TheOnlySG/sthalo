# Sthalo frontend environment (local defaults)
# Copy to frontend/.env.local. Get the local key from
# `npx supabase@2.122.0 status -o env`; use ANON_KEY (legacy JWT) or
# PUBLISHABLE_KEY. Hosted URLs are intentionally absent; set them in Cloudflare
# Pages after the project has actually been created and no-card signup is verified.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
